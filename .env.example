# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_DB=multisite_ikas
POSTGRES_USER=ikas
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_PORT=5432

# ── ASP.NET Core ───────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production

# ── Ports ──────────────────────────────────────────────────────────────────────
API_PORT=5155
WORKER_PORT=5156

# ── JWT ────────────────────────────────────────────────────────────────────────
# En az 32 karakter, tamamen rastgele bir string kullan
JWT_SECRET=CHANGE_ME_RANDOM_STRING_MIN_32_CHARS_abcdef1234567890

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ORIGIN=https://yourdomain.com

# ── Admin Kullanıcı (ilk çalışmada otomatik oluşturulur) ──────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# ── Hangfire Dashboard ─────────────────────────────────────────────────────────
HANGFIRE_USER=admin
HANGFIRE_PASSWORD=CHANGE_ME_HANGFIRE_PASSWORD
