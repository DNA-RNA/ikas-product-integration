{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=postgres;Username=ranayalcin;Password=postgres"
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/worker-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithThreadId" ]
  },

  "Hangfire": {
    "DashboardPath": "/hangfire",
    "WorkerCount": 5,
    "DashboardUser": "",
    "DashboardPassword": ""
  },

  "JobSchedule": {
    "XmlPullJob": {
      "CronExpression": "0 2 * * *",
      "Enabled": true
    },
    "TransferJob": {
      "CronExpression": "0 6 * * *",
      "Enabled": true
    }
  },

  "AllowedHosts": "*"
}
